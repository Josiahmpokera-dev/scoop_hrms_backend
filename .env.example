# Server
PORT=8080
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=hrms_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# Local storage (fallback when S3 is not configured)
STORAGE_PATH=./storage
STORAGE_URL=/storage

# AWS S3 Configuration (set these to enable S3 uploads)
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_BASE_URL=https://your-bucket-name.s3.eu-west-1.amazonaws.com
AWS_S3_DOCS_PREFIX=prefix/
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Biometric Device
DEVICE_IP=10.4.9.24
DEVICE_PORT=8087
DEVICE_PIN=0
TIMEZONE=UTC
BIO_USERNAME=Developer
BIO_PASSWORD=Developer@123

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=biotime_exchange
RABBITMQ_QUEUE=biotime_transactions
RABBITMQ_PROCESSING_INTERVAL=5
RABBITMQ_BATCH_SIZE=10
