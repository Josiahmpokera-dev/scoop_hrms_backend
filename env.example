# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=hrms_db
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRY=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# File Storage Configuration
STORAGE_PATH=./storage
STORAGE_URL=/storage

# BioTime Biometric Device Configuration
BIOTIME_BASE_URL=http://10.4.9.24:8087
BIOTIME_USERNAME=Developer
BIOTIME_PASSWORD=Developer@123
BIOTIME_ENABLED=true

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=biotime_exchange
RABBITMQ_QUEUE=biotime_transactions

# Queue Processing Configuration
# RABBITMQ_PROCESSING_INTERVAL: Processing interval in seconds
#   - 0 = Process immediately as messages arrive (default, recommended for real-time)
#   - 5 = Process every 5 seconds
#   - 60 = Process every 1 minute
#   - 300 = Process every 5 minutes
RABBITMQ_PROCESSING_INTERVAL=0

# RABBITMQ_BATCH_SIZE: Number of messages to process in a batch
#   - 0 = Process one message at a time (default)
#   - 10 = Process 10 messages per batch
#   - 100 = Process 100 messages per batch
RABBITMQ_BATCH_SIZE=0
